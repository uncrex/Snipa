# Prefer a dedicated, low-balance bot wallet. Never commit its keypair.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_KEYPAIR_PATH=~/.config/solana/id.json
# SOLANA_PRIVATE_KEY=base58-or-json-secret

# Optional for the PumpPortal WebSocket; required for metered streams.
PUMPPORTAL_API_KEY=

# Safety defaults: monitoring and simulated orders only.
LIVE_TRADING=false
# Live orders remain blocked unless this file contains the exact acknowledgement.
LIVE_TRADING_ARM_PATH=./live-trading.armed
AUTO_BUY=false
BUY_AMOUNT_SOL=0.01
MAX_BUYS_PER_SESSION=1
MAX_SESSION_BUY_SOL=0.05
MIN_SOL_RESERVE=0.02
SLIPPAGE_PERCENT=0.5
PRIORITY_FEE_SOL=0.00005
# Optional minimum unused compute margin for live buys, in basis points (1000 = 10%).
MIN_COMPUTE_HEADROOM_BPS=
# Reject a live trade if preflight, route construction, policy, audit, or
# simulation takes longer than this wall-clock budget.
MAX_TRADE_INTENT_AGE_MS=10000

# Optional case-insensitive regular expressions. Both must match when set.
TOKEN_NAME_REGEX=
TOKEN_SYMBOL_REGEX=

# Append-only JSONL trade decision lifecycle. Required for every live buy.
# Journal failure blocks new exposure but does not block sell exits.
TRADE_JOURNAL_ENABLED=true
TRADE_JOURNAL_PATH=./trades.jsonl
# Optional local submission-to-confirmation observation threshold. No default.
SUBMISSION_CONFIRMATION_ALERT_MS=

# Rebuildable dashboard projection events. Queue overflow never blocks trading.
DASHBOARD_EVENT_LOG_ENABLED=true
DASHBOARD_EVENT_LOG_PATH=./dashboard-events.jsonl
DASHBOARD_EVENT_QUEUE_CAPACITY=1000
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=8787
# Mark nonempty projection data stale after this event age.
DASHBOARD_PROJECTION_STALE_AFTER_MS=60000

# Telegram bot tokens are secrets. Create/revoke them with @BotFather and enter
# replacements only in .env; never paste them into source, commits, or chat.
TELEGRAM_MOD_BOT_TOKEN=
TELEGRAM_ALERT_BOT_TOKEN=
# Discover this negative numeric ID after adding @WetzelSOLModBot to the group.
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_MOD_BOT_USERNAME=WetzelSOLModBot
TELEGRAM_ALERT_BOT_USERNAME=WetzelSOLBot
TELEGRAM_PROJECT_NAME=Wetzel
TELEGRAM_WEBSITE_URL=https://wetzel.vip/
TELEGRAM_X_URL=https://x.com/WetzelSOL
TELEGRAM_TOKEN_URL=https://pump.fun/coin/FYwxAEKhksrMFeUgxwRE99Jn3BcdzK3Y1JPUbkf3pump
TELEGRAM_COINSNIPER_URL=https://coinsniper.net/coin/93831
TELEGRAM_COINMOONER_URL=https://coinmooner.com/coins/wetzel-wetzel
TELEGRAM_DEXSCREENER_URL=https://dexscreener.com/solana/DDH9miPnwA4czQbR2jWn8hF1sou755w4scGMfXXk6e6g
TELEGRAM_GECKOTERMINAL_URL=https://www.geckoterminal.com/solana/pools/DDH9miPnwA4czQbR2jWn8hF1sou755w4scGMfXXk6e6g
TELEGRAM_BIRDEYE_URL=https://birdeye.so/solana/token/FYwxAEKhksrMFeUgxwRE99Jn3BcdzK3Y1JPUbkf3pump
TELEGRAM_DEXTOOLS_URL=https://www.dextools.io/app/en/solana/pair-explorer/FYwxAEKhksrMFeUgxwRE99Jn3BcdzK3Y1JPUbkf3pump
TELEGRAM_CMC_DEXSCAN_URL=https://dex.coinmarketcap.com/solana/DDH9miPnwA4czQbR2jWn8hF1sou755w4scGMfXXk6e6g/
TELEGRAM_ALERT_MINT=FYwxAEKhksrMFeUgxwRE99Jn3BcdzK3Y1JPUbkf3pump
TELEGRAM_BUY_ALERT_MIN_SOL=0.01
TELEGRAM_PUBLIC_BUY_LOOKBACK_SECONDS=3600
TELEGRAM_ALERT_POLL_INTERVAL_MS=2000
TELEGRAM_ALERT_ANIMATION_PATH=./assets/WETZEL-Buy-Alert.mp4
TELEGRAM_ALERT_SENT_LOG_PATH=./telegram-alerts-sent.jsonl
TELEGRAM_NEW_MEMBER_RESTRICTION_SECONDS=600
TELEGRAM_INCIDENT_LOG_PATH=./telegram-incidents.jsonl
TELEGRAM_CAMPAIGN_LOG_PATH=./telegram-campaigns.jsonl

# Fail-closed top-level transaction program allowlist. Add only verified IDs.
ALLOWED_PROGRAM_IDS=11111111111111111111111111111111,ComputeBudget111111111111111111111111111111,TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA,ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL,6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P,pAMMBay6oceH9fJKBRHGP5D4bD4sWpmSwMn52FMfXEA